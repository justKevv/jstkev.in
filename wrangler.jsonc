{
	"compatibility_date": "2026-04-28",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "jstkev-in",
	"assets": {
		"directory": "./dist",
		"html_handling": "drop-trailing-slash"
	},
	"vars": {
    "PUBLIC_MEDIA_BASE_URL": "https://media.jstkev.in"
  },
	"observability": {
		"enabled": true
	}
}
