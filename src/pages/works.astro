---
import MainLayout from "../layouts/MainLayout.astro";
import SectionLayout from "../layouts/SectionLayout.astro";
import { works } from "../data/works";
import WorksCard from "../components/cards/WorksCard.astro";
---

<MainLayout
  title="Works"
  description="Professional experience and work history of Kevin Bramasta, software developer and machine learning engineer from Malang, Indonesia."
  image="/og-image.png"
>
    <SectionLayout title="Works">
        <section class="[&>details]:border-b [&>details]:border-black/20">           
            {works.map((work, index) => (
              <WorksCard
                  index={index}
                  company={work.company}
                  type={work.type}
                  location={work.location}
                  role={work.role}
                  date={work.date}
                  highlights={work.highlights}
                  stack={work.stack}
              />
            ))}
        </section>
    </SectionLayout>
</MainLayout>
