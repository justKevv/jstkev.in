---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout
  isPinnedFooter={true}
  title="jst.kevv place."
  description="Kevin Bramasta Arvyto Wardhana — a developer from Malang, Indonesia with 2+ years in software development and machine learning."
  image="/og-image.png"
>
    <section class="h-full min-h-0 flex flex-col justify-between items-center gap-3">
        <div
            data-torii-artwork
            class="relative aspect-video w-full max-w-160 my-4 overflow-hidden [mask-image:url('/Pixel.png')] [-webkit-mask-image:url('/Pixel.png')] [mask-repeat:no-repeat] [-webkit-mask-repeat:no-repeat] [mask-position:center] [-webkit-mask-position:center] [mask-size:108%_108%] [-webkit-mask-size:108%_108%]"
            role="img"
            aria-label="Watercolor torii gate artwork"
        >
            <canvas data-torii-canvas class="pointer-events-none absolute inset-y-0 block h-full w-auto"></canvas>
        </div>
        <div class="mx-auto flex w-[calc(100%-5rem)] max-w-120 flex-col gap-6 font-family-cause text-left sm:w-full">
            <h1 class="text-sm font-semibold sm:text-[15px]">Kevin Bramasta</h1>
            <p class="text-[13px] leading-5 text-neutral-700 sm:text-[14px] sm:leading-6">
                Developer and student from Indonesia, currently studying in Shenyang.
            </p>
            <p class="text-[13px] leading-5 text-neutral-700 sm:text-[14px] sm:leading-6">
                I build things with <span class="font-medium text-neutral-900">code</span>, and wander into <span class="font-medium text-neutral-900">design</span>, <span class="font-medium text-neutral-900">photography</span>, and whatever else catches my curiosity.
            </p>
        </div>
    </section>
</MainLayout>

<script>
    import '../scripts/torii-artwork.js';
</script>
