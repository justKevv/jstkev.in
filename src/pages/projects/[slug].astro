---
import MainLayout from "../../layouts/MainLayout.astro";
import { getCollection, render } from "astro:content";
import { getStackUrl, getStackIcon } from "../../data/stacks";
import { Image } from "astro:assets";
import generateSlug from "../../lib/generateSlug";
import { sortProjects } from "../../lib/sortProjects";
import Github from "../../../public/icons/github.svg";
import HoverLogo from "../../components/HoverLogo.astro";

export async function getStaticPaths() {
  const projects = sortProjects(await getCollection("projects"));
  return projects.map((project, index) => ({
    params: { slug: generateSlug(project.data.name) },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const stack = project.data.stack;

const projectUrl = new URL(Astro.url.pathname, Astro.site);
const projectSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  "name": project.data.name,
  "description": project.data.description,
  "image": project.data.image
    ? new URL(project.data.image.src, Astro.site).href
    : new URL("/og-image.png", Astro.site).href,
  // date is a human-readable display string (e.g. "aug 2025 - jan 2026"), not an ISO date
  "temporalCoverage": project.data.date,
  "author": {
    "@type": "Person",
    "name": "Kevin Bramasta Arvyto Wardhana",
    "url": Astro.site
  },
  "publisher": {
    "@type": "Organization",
    "name": "jstkev.in",
    "logo": {
      "@type": "ImageObject",
      "url": new URL("/文.png", Astro.site).href
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": projectUrl.href
  },
  "programmingLanguage": project.data.stack || [],
  "codeRepository": project.data.github,
  "url": project.data.live_link
};
---

<MainLayout
  title={project.data.name}
  description={project.data.description}
  image={project.data.image}
  type="article"
  jsonLd={projectSchema}
  author="Kevin Bramasta Arvyto Wardhana"
  section="Projects"
  tags={stack}
>
  <section class="font-family-cause mx-auto flex w-full max-w-2xl flex-col justify-start gap-6 px-10 py-6 max-md:px-5">
    <h1 class="split-paraf text-xl font-semibold">{project.data.name}</h1>

    <p class="split-paraf text-sm leading-relaxed text-zinc-700">
      {project.data.description} <span class="mr-1">Built with</span>
      {stack.map((tech, i) => {
        const url = getStackUrl(tech);
        const separator = i === stack.length - 1 ? "" : i === stack.length - 2 ? " and " : ", ";
        const rotation = (Math.random() * 16 - 8).toFixed(1);
        return (
          <>
            <HoverLogo
              label={tech}
              logo={`https://api.iconify.design/${getStackIcon(tech)}.svg`}
              href={url || undefined}
              rotation={`${rotation}deg`}
            />
            {separator}
          </>
        );
      })}.
    </p>

    <div class="flex items-center text-sm">
      <div class="flex items-center gap-5">
        {project.data.github && (
          <a href={project.data.github} target="_blank" rel="noreferrer" class="flex items-center gap-1.5 text-neutral-600 underline underline-offset-4">
            <Github class="h-3.5 w-3.5" aria-hidden="true" />
            GitHub
          </a>
        )}
        {project.data.live_link && (
          <a href={project.data.live_link} target="_blank" rel="noreferrer" class="flex items-center gap-1.5 text-neutral-600 underline underline-offset-4">
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><ellipse cx="12" cy="12" rx="4" ry="9" /><line x1="3" y1="12" x2="21" y2="12" /></svg>
            Live
          </a>
        )}
      </div>
    </div>

    {project.data.image && (
      <Image
        src={project.data.image}
        loading="eager"
        fetchpriority="high"
        decoding="sync"
        alt={`${project.data.name} preview`}
        class="aspect-16/10 w-full border border-neutral-200 object-cover"
      />
    )}

    <article class="prose prose-sm max-w-none **:text-[15px] **:leading-relaxed">
      <Content />
    </article>
  </section>
</MainLayout>
