---
import MainLayout from "../layouts/MainLayout.astro";
import ProjectsCard from "../components/cards/ProjectsCard.astro";
import { getCollection } from "astro:content";
import generateSlug from "../lib/generateSlug";
import { sortProjects } from "../lib/sortProjects";

const projects = sortProjects(await getCollection("projects"));
---

<MainLayout
  title="Projects"
  description="Personal and academic projects by Kevin Bramasta, showcasing software development, machine learning, and creative coding experiments."
  image="/og-image.png"
>
    <section class="font-family-cause mx-auto flex w-full max-w-2xl flex-col justify-start gap-8 px-10 py-6 max-md:px-5">
        <header class="flex flex-col gap-3">
            <div class="relative w-fit">
                <h1 class="split-paraf text-xl font-semibold">Projects</h1>
                <svg class="absolute -bottom-2 left-0 h-2.5 w-full" viewBox="0 0 100 10" preserveAspectRatio="none" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M1 6 C 12 1, 22 10, 34 5 S 56 2, 68 6 S 90 9, 99 4" vector-effect="non-scaling-stroke" /></svg>
            </div>
            <p class="split-paraf text-base text-zinc-700">Things I've built with <strong class="font-semibold text-black">code</strong>, newest first. Take a stroll through them.</p>
        </header>


        <ul class="border-t border-black/10">
            {projects.map((project, index) => (
                <ProjectsCard
                    index={index}
                    name={project.data.name}
                    description={project.data.description}
                    stack={project.data.stack}
                    content_link={generateSlug(project.data.name)}
                />
            ))}
        </ul>
    </section>
</MainLayout>
