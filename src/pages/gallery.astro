---
import MainLayout from "../layouts/MainLayout.astro";
import { Masonry } from "astro-masonry";

const response = await fetch("https://gallery-api.kevinbramastaa.workers.dev/media");

if (!response.ok) {
  throw new Error("Failed to load gallery");
}

const media = await response.json();

const items = [
  ...(media.videos ?? []).map((url: string) => ({
    url,
    kind: "video" as const,
  })),
  ...(media.photos ?? []).map((url: string) => ({
    url,
    kind: "photo" as const,
  })),
];

function mulberry32(seed: number) {
  return () => {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const random = mulberry32(42);
for (let i = items.length - 1; i > 0; i--) {
  const j = Math.floor(random() * (i + 1));
  [items[i], items[j]] = [items[j], items[i]];
}
---

<MainLayout
  title="Gallery"
  description="Tapes and shots by Kevin Bramasta."
  image="/og-image.png"
>
    <section class="font-family-cause mx-auto flex w-full max-w-235 flex-col justify-center gap-8 px-10 py-6 max-md:px-5">
        <header class="flex flex-col gap-3">
            <div class="relative w-fit">
                <h1 class="split-paraf text-xl font-semibold">Gallery</h1>
                <svg class="absolute -bottom-2 left-0 h-2.5 w-full" viewBox="0 0 100 10" preserveAspectRatio="none" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M1 6 C 12 1, 22 10, 34 5 S 56 2, 68 6 S 90 9, 99 4" vector-effect="non-scaling-stroke" /></svg>
            </div>
            <p class="split-paraf text-base text-zinc-700">Tapes and shots, <strong class="font-semibold text-black">on film</strong>. Take a stroll through them.</p>
        </header>

        <Masonry
            breakpointCols={{
            default: 4,
            700: 3
            }}
            class="gap-3 flex"
        >
            {items.map((item) => (
              <div class="mb-3 overflow-hidden bg-black">
                <button
                  type="button"
                  class="block w-full cursor-zoom-in"
                  data-lightbox-kind={item.kind}
                  data-lightbox-url={item.url}
                >
                  {item.kind === "video" ? (
                    <video
                      src={item.url}
                      muted
                      autoplay
                      loop
                      playsinline
                      preload="none"
                      class="block h-auto w-full"
                    />
                  ) : (
                    <img
                      src={item.url}
                      alt=""
                      loading="lazy"
                      decoding="async"
                      class="block h-auto w-full"
                    />
                  )}
                </button>
              </div>
            ))}
        </Masonry>
    </section>

    <dialog
      id="lightbox"
      class="m-auto max-h-[90vh] max-w-[90vw] overflow-visible bg-transparent p-0 backdrop:bg-black/80"
    >
      <button
        type="button"
        data-lightbox-close
        class="absolute -top-10 right-0 text-2xl leading-none text-white"
        aria-label="Close"
      >
        &times;
      </button>
      <div id="lightbox-content" class="flex items-center justify-center"></div>
    </dialog>
</MainLayout>

<script>
  const dialog = document.getElementById("lightbox") as HTMLDialogElement;
  const content = document.getElementById("lightbox-content")!;

  document.querySelectorAll<HTMLButtonElement>("[data-lightbox-url]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const url = btn.dataset.lightboxUrl!;
      const el =
        btn.dataset.lightboxKind === "video"
          ? Object.assign(document.createElement("video"), {
              src: url,
              controls: true,
              autoplay: true,
              playsInline: true,
              className: "max-h-[90vh] max-w-[90vw]",
            })
          : Object.assign(document.createElement("img"), {
              src: url,
              alt: "",
              className: "max-h-[90vh] max-w-[90vw] object-contain",
            });
      content.replaceChildren(el);
      dialog.showModal();
    });
  });

  dialog.querySelector("[data-lightbox-close]")!.addEventListener("click", () => dialog.close());
  dialog.addEventListener("click", (e) => {
    if (e.target === dialog) dialog.close();
  });
  dialog.addEventListener("close", () => content.replaceChildren());
</script>
