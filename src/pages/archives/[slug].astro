---
import MainLayout from "../../layouts/MainLayout.astro";
import SectionLayout from "../../layouts/SectionLayout.astro";
import { getCollection } from "astro:content";
import generateSlug from "../../lib/generateSlug";
import { render } from "astro:content";

export async function getStaticPaths() {
  const archives = await getCollection("archives");
  return archives.map((archive) => ({
    params: {slug: generateSlug(archive.data.title)},
    props: {archive}
  }));
};

const { archive } = Astro.props
const { Content, remarkPluginFrontmatter } = await render(archive);
const dateObject = new Date(archive.data.date);

const formattedDate = dateObject.toLocaleDateString('en-SG', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

const articleUrl = new URL(Astro.url.pathname, Astro.site);
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": archive.data.title,
  "description": archive.data.description,
  "image": new URL("/og-image.png", Astro.site).href,
  "datePublished": dateObject.toISOString(),
  "dateModified": dateObject.toISOString(),
  "author": {
    "@type": "Person",
    "name": "Kevin Bramasta Arvyto Wardhana",
    "url": Astro.site
  },
  "publisher": {
    "@type": "Organization",
    "name": "jstkev.in",
    "logo": {
      "@type": "ImageObject",
      "url": new URL("/文.png", Astro.site).href
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": articleUrl.href
  }
};
---

<MainLayout
  title={archive.data.title}
  description={archive.data.description}
  image="/og-image.png"
  type="article"
  jsonLd={articleSchema}
  publishedTime={dateObject.toISOString()}
  modifiedTime={dateObject.toISOString()}
  author="Kevin Bramasta Arvyto Wardhana"
  section={archive.data.category}
  tags={[]}
>
    <SectionLayout>
        <article class="mx-1 md:mx-10 lg:mx-40">
        
          <div class="card-detail relative w-full h-56 md:h-72 rounded-lg border border-neutral-400 bg-neutral-100 overflow-hidden mb-8">
            <!-- <img src="/placeholder.jpg" alt="" class="w-full h-full object-cover" /> -->
            <span class="absolute capitalize top-3 left-3 text-[10px] px-2.5 py-1 rounded-md border border-neutral-500 bg-white text-neutral-900">
              {archive.data.category}
            </span>
          </div>
        
          <div class="card-detail text-sm text-neutral-500 mb-2">
            <time datetime={dateObject.toISOString()}>{formattedDate}</time> &nbsp;&middot;&nbsp; {remarkPluginFrontmatter.minutesRead}
          </div>
        
          <h1 class="card-detail font-serif text-3xl md:text-4xl leading-tight mb-4">
            {archive.data.title}
          </h1>
        
          <article class="card-detail prose prose-sm **:text-[15px] max-w-none">
            <Content />
          </article>
        
        </article>
    </SectionLayout>
</MainLayout>