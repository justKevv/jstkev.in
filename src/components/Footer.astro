---
import Github from "../../public/icons/github.svg"
import Email from "../../public/icons/mail.svg"
import Resume from "../../public/icons/Document.svg"

const footItems = [
  { href: "/kevin_bramasta_softwaredeveloper.pdf", icon: Resume },
  { href: "https://github.com/justKevv", icon: Github },
  { href: "mailto:kevinbramastaa@gmail.com", icon: Email },
];
---

<footer class="flex text-[12px] lg:text-[13px] justify-center items-center px-10 py-8">
    <section class="flex flex-row items-center gap-10">
        {footItems.map((item, index) => { 
          const Icon = item.icon;
          const rotation = (index - (footItems.length - 1) / 2) * 3;
          
          return (
            <a data-cuelume-press="success" href={item.href} target="_blank">
                <Icon
                    style={`--hover-rotation: ${rotation}deg`}
                    class="hover:scale-110 hover:-translate-y-1 hover:rotate-(--hover-rotation) transition-transform duration-200"
                />
            </a>
          );
        })}
    </section>
</footer>
