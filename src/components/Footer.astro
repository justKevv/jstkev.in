---
const currentPath = Astro.url.pathname;
const footItems = [
  { href: "https://github.com/justKevv", label: "Github" },
  { href: "mailto:kevinbramastaa@gmail.com", label: "Email" },
  { href: "/kevin_bramasta_softwaredeveloper.pdf", label: "Resume" },
];

const showFooter = ["/"].includes(currentPath);
---

{showFooter ?
  <footer class="flex text-[12px] lg:text-[13px] justify-between px-10 py-8">
      <section class="flex flex-col items-start gap-2.5">
          {footItems.map((item) => (
            <a data-cuelume-press="success" class="footer-line relative inline-block after:content-[''] after:absolute after:left-0 after:bottom-0 after:h-px after:w-full after:bg-current after:origin-left after:scale-x-0 after:transition-transform after:duration-250 hover:after:scale-x-100" href={item.href} target="_blank">{item.label}</a>
          ))}
          {currentPath === "/" ? <span class="footer-line text-black/50">Model by <a data-cuelume-press="success" class="underline" href="https://sketchfab.com/SketchyB0t_3D_Fabrication" target="_blank">SketchyBot</a></span> : ""}
      </section>
  </footer>
  :
  <footer class="flex text-[12px] lg:text-[13px] justify-center items-center px-10 py-8">
      <section class="flex flex-row items-center gap-4">
          {footItems.map((item) => (
            <a data-cuelume-press="success" class="footer-line relative inline-block after:content-[''] after:absolute after:left-0 after:bottom-0 after:h-px after:w-full after:bg-current after:origin-left after:scale-x-0 after:transition-transform after:duration-250 hover:after:scale-x-100" href={item.href} target="_blank">{item.label}</a>
          ))}
      </section>
  </footer>
}
