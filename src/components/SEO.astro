---
interface Props {
  title?: string;
  description?: string;
  image?: string | ImageMetadata;
  imageAlt?: string;
  url?: string;
  type?: "website" | "article";
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  section?: string;
  tags?: string[];
}

const {
  title = "jst.kevv place.",
  description = "Kevin Bramasta Arvyto Wardhana — a developer from Malang, Indonesia with 2+ years in software development and machine learning.",
  image = "/og-image.png",
  imageAlt = "Kevin Bramasta — jstkev.in",
  url = Astro.url.href,
  type = "website",
  noindex = false,
  jsonLd,
  publishedTime,
  modifiedTime,
  author = "Kevin Bramasta Arvyto Wardhana",
  section,
  tags,
} = Astro.props;

// Handle both Astro image objects and plain string paths
const imageSrc = typeof image === "string" ? image : image.src;

const siteName = "jstkev.in";
const fullTitle = title === "jst.kevv place." ? title : `${title} · jstkev.in`;
const canonicalURL = new URL(url, Astro.site);
const ogImage = new URL(imageSrc, Astro.site);

// OG Image dimensions (assuming standard 1200x630)
const ogImageWidth = 1200;
const ogImageHeight = 630;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Kevin Bramasta Arvyto Wardhana",
  "alternateName": "Kevin Bramasta",
  "url": "https://jstkev.in",
  "jobTitle": "Software Developer",
  "description": "Developer from Malang, Indonesia with 2+ years in software development and machine learning.",
  "knowsAbout": ["Software Development", "Machine Learning", "Web Development"],
  "sameAs": [
    "https://github.com/justKevv",
    "https://www.linkedin.com/in/kevin-bramasta"
  ]
};
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={author} />
<link rel="canonical" href={canonicalURL} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content={String(ogImageWidth)} />
<meta property="og:image:height" content={String(ogImageHeight)} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:locale" content="en_US" />
<meta property="og:site_name" content={siteName} />
{type === "article" && publishedTime && <>
  <meta property="article:published_time" content={publishedTime} />
  <meta property="article:modified_time" content={modifiedTime || publishedTime} />
  <meta property="article:author" content={author} />
  {section && <meta property="article:section" content={section} />}
  {tags && tags.length > 0 && tags.map((tag) => (
    <meta property="article:tag" content={tag} />
  ))}
</>}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={imageAlt} />

<!-- Person schema — site-wide identity signal -->
<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

<!-- Page-specific schema (BlogPosting, SoftwareSourceCode, etc.) -->
{jsonLd && (
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
)}
