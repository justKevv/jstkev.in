---
import { getStackUrl } from "../../data/stacks";
const { name } = Astro.props;
const url = getStackUrl(name);
---

{url ? (
  <a href={url} target="_blank" class="font-mono text-[14px] border py-0.5 px-2 mx-1 text-accent/60 hover:text-accent tracking-wide transition-colors duration-200"><span>{name}</span></a>
) : (
  <span class="font-mono text-[14px] text-accent tracking-wide">{name}</span>
)}
