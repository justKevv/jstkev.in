---
import { Image } from "astro:assets";
---

<header class="sticky top-0 w-full h-fit z-999 bg-[linear-gradient(to_bottom,#fff_66%,transparent)]">
  <nav class="flex justify-center items-center gap-10 py-8 px-10">
    <a href="/projects" class="font-family-cause">projects</a>

    <a id="logo-switch" href="/" data-astro-prefetch aria-label="Home"
       class="relative inline-flex size-8 select-none items-center justify-center">
      <span id="logo-text"
        class="absolute inset-0 flex items-center justify-center font-family-yrdzst text-[37px] leading-none opacity-100 transition-opacity ease-in-out">文</span>

      <video id="logo-out-video" src="/icons/wen-out.webm" muted playsinline preload="auto"
        class="pointer-events-none absolute left-1/2 top-1/2 z-10 size-[38px] -translate-x-1/2 -translate-y-[calc(50%+1px)] scale-[1.01] object-cover opacity-0 mix-blend-multiply transition-opacity ease-in-out"></video>

      <video id="logo-video" src="/icons/wen.webm" muted playsinline preload="auto" loop
        class="pointer-events-none absolute left-1/2 top-1/2 z-20 size-[38px] -translate-x-1/2 -translate-y-[calc(50%+1px)] scale-[1.01] object-cover opacity-0 mix-blend-multiply transition-opacity ease-in-out"></video>
    </a>

    <a href="/gallery" class="font-family-cause">gallery</a>
  </nav>
</header>

<script>
  const logo = document.querySelector("#logo-switch");
  const text = document.querySelector("#logo-text");
  const outVideo = document.querySelector("#logo-out-video");
  const loopVideo = document.querySelector("#logo-video");

  const HOVER_DELAY = 2500;
  const SWAP_MS = 1000;  // 0 = hard swap
  const RESET_MS = 1000;

  const fade = (el, opacity, ms) => {
    el.style.transitionDuration = `${ms}ms`;
    el.style.opacity = String(opacity);
  };

  // Resolves when the first frame of playback is actually on screen
  const playFromStart = async (video) => {
    video.pause();
    video.currentTime = 0;
    await video.play();
    if ("requestVideoFrameCallback" in video) {
      await new Promise((r) => video.requestVideoFrameCallback(() => r()));
    }
  };

  let phase = "text"; // "text" | "out" | "loop"
  let isHovering = false;
  let hoverTimer;
  let loopEndTimer;

  const goText = () => {
    clearTimeout(hoverTimer);
    clearTimeout(loopEndTimer);
    phase = "text";
    fade(text, 1, RESET_MS);
    fade(outVideo, 0, RESET_MS);
    fade(loopVideo, 0, RESET_MS);
    // pause only after the fade so it doesn't freeze mid-fade
    setTimeout(() => {
      if (phase === "text") {
        outVideo.pause();
        loopVideo.pause();
      }
    }, RESET_MS);
  };

  const startOut = async () => {
    await playFromStart(outVideo);
    if (!isHovering) { outVideo.pause(); return; }
    phase = "out";
    fade(text, 0, SWAP_MS);
    fade(outVideo, 1, SWAP_MS);
  };

  const startLoop = async () => {
    await playFromStart(loopVideo);
    phase = "loop";
    // Swap in the same frame: no opacity dip
    fade(loopVideo, 1, 0);
    fade(outVideo, 0, 0);
  };

  // Out finished -> loop if still hovering, otherwise back to text
  outVideo?.addEventListener("ended", () => {
    if (phase !== "out") return;
    isHovering ? startLoop() : goText();
  });

  // When leaving during the loop, finish the current cycle using real remaining time
  const finishLoopCycle = () => {
    const remaining = (loopVideo.duration - loopVideo.currentTime) * 1000;
    loopEndTimer = setTimeout(() => (isHovering ? undefined : goText()), Math.max(remaining, 0));
  };

  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (logo && text && outVideo && loopVideo && !reduceMotion) {
    logo.addEventListener("pointerenter", (e) => {
      if (e.pointerType !== "mouse") return;
      isHovering = true;
      clearTimeout(loopEndTimer);
      if (phase !== "text") return;
      clearTimeout(hoverTimer);
      hoverTimer = setTimeout(startOut, HOVER_DELAY);
    });

    logo.addEventListener("pointerleave", (e) => {
      if (e.pointerType !== "mouse") return;
      isHovering = false;
      clearTimeout(hoverTimer);
      if (phase === "loop") finishLoopCycle();
      // phase "out": the "ended" handler sees isHovering === false and calls goText()
    });
  }
</script>
