---
import { getStackUrl } from "../../data/stacks";
import type { WorkItem } from "../../types/work";

const props = Astro.props as WorkItem & { index: number };
---

<details data-cuelume-press="press" data-cuelume-release="release" class="group" open={props.index === 0}>
    <summary class="flex flex-wrap items-baseline gap-4 py-5 cursor-pointer list-none marker:hidden max-[1024px]:gap-x-3 max-[1024px]:gap-y-2.5 max-[1024px]:py-4">
        <span class="select-none w-12 shrink-0 text-black/50 text-[12px] uppercase tracking-[.08em] max-[1024px]:order-1 max-[1024px]:w-8">0{props.index + 1}</span>
        <span class="select-none min-w-40 flex-[1.3] wrap-break-word font-family-playfair text-[1.35rem] leading-none capitalize group-hover:underline group-hover:underline-offset-4 group-open:underline group-open:underline-offset-4 max-[1024px]:order-2 max-[1024px]:min-w-0 max-[1024px]:flex-1 max-[1024px]:text-[1.15rem]">{props.role}</span>
        <span class="select-none flex-1 min-w-0 wrap-break-word pr-8 text-black/50 text-[12px] leading-tight uppercase tracking-[.08em] max-[1024px]:order-4 max-[1024px]:basis-full max-[1024px]:ml-11 max-[1024px]:pr-0 max-[1024px]:text-[10px]">{props.company}</span>
        <span class="select-none w-44 shrink-0 text-black/50 text-[12px] leading-tight uppercase tracking-[.08em] max-[1024px]:order-5 max-[1024px]:ml-11 max-[1024px]:w-auto max-[1024px]:basis-auto max-[1024px]:text-[10px]">{props.date}</span>
        <span class="select-none w-44 shrink-0 text-black/50 text-[12px] leading-tight uppercase tracking-[.08em] max-[1024px]:order-6 max-[1024px]:w-auto max-[1024px]:basis-auto max-[1024px]:text-[10px]">{props.type}</span>
        <span class="select-none w-4 shrink-0 text-right text-black/50 text-[1.2rem] leading-none transition-transform group-open:rotate-45 group-open:text-black max-[1024px]:order-3 max-[1024px]:ml-auto" aria-hidden="true">+</span>
    </summary>
  <div class="mb-5 ml-12 border-l border-black/20 pl-4 max-[1024px]:mb-4 max-[1024px]:ml-11 max-[1024px]:pl-3">
    <p class="max-w-152 wrap-break-word text-[.85rem] leading-normal text-black/50">{props.highlights}</p>
    <div class="mt-3.5 flex flex-wrap gap-x-3.5 gap-y-2.5">
      {props.stack.slice(0, 5).map((tech) => <a class="text-black/50 font-mono text-[10px] uppercase tracking-[.08em] hover:text-black" href={getStackUrl(tech)} target="_blank" rel="noreferrer">{tech}</a>)}
    </div>
  </div>
</details>
