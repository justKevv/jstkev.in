---
const KANJI = ["一", "二", "三", "四", "五", "六", "七", "八", "九", "十"];

interface Props {
  index: number;
  name: string;
  description: string;
  stack: string[];
  content_link: string;
}

const { index, name, description, stack, content_link } = Astro.props;
const marker = KANJI[index] ?? String(index + 1);
---

<li class="relative border-b border-black/10">
    <a href={`/projects/${content_link}`} class="flex items-start gap-6 px-5 py-7 focus:outline-none focus-visible:ring-2 focus-visible:ring-black/40 max-md:gap-4 max-md:px-3">
        <span class="w-8 shrink-0 select-none text-lg text-neutral-400" aria-hidden="true">{marker}</span>

        <div class="flex min-w-0 flex-1 flex-col gap-2">
            <h3 class="text-lg font-medium text-black max-md:text-base">{name}</h3>
            <p class="text-sm text-zinc-700">{description}</p>
            <div class="mt-1 flex flex-wrap gap-2">
                {stack.map((tech) => (
                    <span class="font-family-cause border border-neutral-200 bg-neutral-100 px-2 py-0.5 text-xs text-neutral-600">{tech}</span>
                ))}
            </div>
        </div>
    </a>
</li>
