---
import type { ArchiveItem } from '../../types/archive'
const props = Astro.props as ArchiveItem;
const { duration } = Astro.props

const dateObject = new Date(props.date);

const formattedDate = dateObject.toLocaleDateString('en-SG', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

const [first] = props.title;
---

<article class="card">
    <a href={`/archives/${props.link}`} class="cursor-pointer h-full bg-white border border-neutral-400 hover:border-black transition duration-300 flex flex-row px-4 py-6 mx-8 gap-4 rounded-lg">
        <div class="h-16 w-16 select-none rounded-lg border border-neutral-500 items-center flex justify-center leading-none text-6xl overflow-clip font-family-playfair capitalize"><span class="-translate-y-0.5">{first}</span></div>
        <div class="flex flex-col gap-1">                
            <div class="flex flex-row gap-3 items-center text-neutral-500 justify-start">
                <p class="text-xs capitalize">{props.category}</p>
                <span class="w-1 h-1 rounded-full bg-neutral-500" />
                <time datetime={dateObject.toISOString()} class="text-xs">{formattedDate}</time>
                <span class="w-1 h-1 rounded-full bg-neutral-500" />
                <p class="text-xs">{duration}</p>
            </div>
            <div class="flex flex-col gap-1">         
                <h2 class="capitalize text-xl">{props.title}</h2>
                <p class="max-w-xl text-sm text-neutral-500 font-light wrap-break-word">{props.description}</p>
            </div>
        </div>
    </a>
</article>