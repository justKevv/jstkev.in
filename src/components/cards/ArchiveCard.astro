---
import type { ArchiveItem } from '../../types/archive'
const props = Astro.props as ArchiveItem;
const { duration } = Astro.props

const dateObject = new Date(props.date);

const formattedDate = dateObject.toLocaleDateString('en-SG', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

const [first] = props.title;
---

<article class="card">
    <a href={`/archives/${props.link}`} class="cursor-pointer h-full bg-white border border-neutral-400 hover:border-black transition duration-300 flex flex-row items-start px-3 py-4 md:px-4 md:py-6 mx-2 md:mx-8 gap-3 md:gap-4 rounded-lg">
        <div class="h-12 w-12 md:h-16 md:w-16 shrink-0 select-none rounded-lg border border-neutral-500 items-center flex justify-center leading-none text-3xl md:text-6xl overflow-clip font-family-playfair capitalize">
            <span class="-translate-y-0.5">{first}</span>
        </div>
        <div class="flex flex-col gap-1 min-w-0">
            <div class="flex flex-row flex-wrap gap-2 md:gap-3 items-center text-[10px] md:text-xs text-neutral-500 justify-start">
                <p class="capitalize">{props.category}</p>
                <span class="w-1 h-1 rounded-full bg-neutral-500" />
                <time datetime={dateObject.toISOString()}>{formattedDate}</time>
                <span class="w-1 h-1 rounded-full bg-neutral-500" />
                <p>{duration}</p>
            </div>
            <div class="flex flex-col gap-1">
                <h2 class="capitalize text-sm md:text-xl line-clamp-1">{props.title}</h2>
                <p class="max-w-xl text-[11px] md:text-sm text-neutral-500 font-light wrap-break-word">{props.description}</p>
            </div>
        </div>
    </a>
</article>