<section data-pr-section class="mx-auto flex w-[calc(100%-5rem)] max-w-120 flex-col justify-center gap-4 py-12 font-family-cause sm:w-full" aria-label="Merged pull requests" hidden>
    <div class="flex items-center justify-between text-xs text-neutral-500">
        <span class="text-[13px]">Contributions</span>
        <span data-pr-count></span>
    </div>

    <p data-pr-error class="text-xs text-neutral-500" hidden>Couldn't load pull requests right now.</p>

    <ul data-pr-list class="flex flex-col gap-3"></ul>

    <details data-pr-more class="group" hidden>
        <summary class="cursor-pointer list-none text-xs text-neutral-500 transition-colors hover:text-neutral-950 [&::-webkit-details-marker]:hidden">
            <span class="group-open:hidden" data-pr-more-closed></span>
            <span class="hidden group-open:inline">Show less</span>
        </summary>
        <ul data-pr-more-list class="mt-3 flex flex-col gap-3"></ul>
    </details>
</section>

<script>
    const GITHUB_USERNAME = 'justKevv';
    const EXCLUDED_REPOS = [
        'xavierzaidane/resume-ai',
        'yourfzz/mgym',
        'srikresna/preparation-git',
    ];
    const RECENT_COUNT = 5;
    const API = 'https://api.github.com';

    interface PullRequest {
        repo: string;
        title: string;
        url: string;
        additions: number | null;
        deletions: number | null;
    }

    const renderItem = (pr: PullRequest) => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = pr.url;
        a.target = '_blank';
        a.rel = 'noopener noreferrer';
        a.className = 'group flex flex-col gap-0.5 transition-colors hover:text-neutral-950';

        const title = document.createElement('span');
        title.className = 'text-[13px] text-neutral-900 group-hover:underline';
        title.textContent = pr.title;

        const meta = document.createElement('span');
        meta.className = 'text-xs text-neutral-500';
        meta.textContent = pr.repo;
        if (pr.additions !== null && pr.deletions !== null) {
            const stats = document.createElement('span');
            stats.append(' · ');
            const add = document.createElement('span');
            add.className = 'text-[#1C7448]';
            add.textContent = `+${pr.additions}`;
            const del = document.createElement('span');
            del.className = 'text-[#741C1C]';
            del.textContent = `−${pr.deletions}`;
            stats.append(add, ' ', del);
            meta.append(stats);
        }

        a.append(title, meta);
        li.append(a);
        return li;
    };

    const loadPullRequests = async () => {
        const section = document.querySelector<HTMLElement>('[data-pr-section]');
        if (!section) return;
        const list = section.querySelector('[data-pr-list]')!;
        const moreList = section.querySelector('[data-pr-more-list]')!;
        const more = section.querySelector<HTMLElement>('[data-pr-more]')!;
        const count = section.querySelector('[data-pr-count]')!;
        const error = section.querySelector<HTMLElement>('[data-pr-error]')!;

        const showError = () => {
            error.hidden = false;
            section.hidden = false;
        };

        try {
            const query = `type:pr is:merged author:${GITHUB_USERNAME} -user:${GITHUB_USERNAME}`;
            const response = await fetch(`${API}/search/issues?q=${encodeURIComponent(query)}&sort=created&order=desc&per_page=100`, {
                headers: { Accept: 'application/vnd.github+json' },
            });
            if (!response.ok) throw new Error(`search failed: ${response.status}`);

            const data = await response.json();
            const items: { title: string; html_url: string; repository_url: string; number: number }[] = (data.items ?? [])
                .filter((item: { repository_url: string }) => !EXCLUDED_REPOS.includes(item.repository_url.replace(`${API}/repos/`, '')));

            // Line counts only for the visible PRs; each one is an extra API call per visitor.
            const pullRequests: PullRequest[] = await Promise.all(items.map(async (item, index) => {
                let additions: number | null = null;
                let deletions: number | null = null;
                if (index < RECENT_COUNT) {
                    try {
                        const detailResponse = await fetch(`${item.repository_url}/pulls/${item.number}`, {
                            headers: { Accept: 'application/vnd.github+json' },
                        });
                        if (detailResponse.ok) {
                            const detail = await detailResponse.json();
                            additions = detail.additions ?? null;
                            deletions = detail.deletions ?? null;
                        }
                    } catch {}
                }
                return {
                    repo: item.repository_url.replace(`${API}/repos/`, ''),
                    title: item.title,
                    url: item.html_url,
                    additions,
                    deletions,
                };
            }));

            if (pullRequests.length === 0) return;

            count.textContent = `${pullRequests.length} merged`;
            pullRequests.slice(0, RECENT_COUNT).forEach((pr) => list.append(renderItem(pr)));
            const rest = pullRequests.slice(RECENT_COUNT);
            if (rest.length > 0) {
                rest.forEach((pr) => moreList.append(renderItem(pr)));
                more.querySelector('[data-pr-more-closed]')!.textContent = `Show more (${rest.length})`;
                more.hidden = false;
            }
            section.hidden = false;
        } catch (error) {
            console.error('[PullRequests]', error);
            showError();
        }
    };

    loadPullRequests();
</script>
