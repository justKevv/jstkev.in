---
const GITHUB_USERNAME = 'justKevv';

const EXCLUDED_REPOS: string[] = [
    'xavierzaidane/resume-ai',
    'yourfzz/mgym',
    'srikresna/preparation-git',
];
const RECENT_COUNT = 5;

interface PullRequest {
    repo: string;
    title: string;
    url: string;
    additions: number | null;
    deletions: number | null;
}

const headers: Record<string, string> = {
    Accept: 'application/vnd.github+json',
    'User-Agent': `${GITHUB_USERNAME}-portfolio`,
};
if (import.meta.env.GITHUB_TOKEN) headers.Authorization = `Bearer ${import.meta.env.GITHUB_TOKEN}`;

let pullRequests: PullRequest[] = [];
let loadError = false;

try {
    const query = `type:pr is:merged author:${GITHUB_USERNAME} -user:${GITHUB_USERNAME}`;
    const response = await fetch(`https://api.github.com/search/issues?q=${encodeURIComponent(query)}&sort=created&order=desc&per_page=100`, { headers });
    if (!response.ok) {
        console.warn(`[PullRequests] search failed: ${response.status} ${response.statusText}`, await response.text());
        loadError = true;
    } else {
        const data = await response.json();
        const items: { title: string; html_url: string; repository_url: string; number: number }[] = (data.items ?? [])
            .filter((item: { repository_url: string }) => !EXCLUDED_REPOS.includes(item.repository_url.replace('https://api.github.com/repos/', '')));

        pullRequests = await Promise.all(items.map(async (item) => {
            let additions: number | null = null;
            let deletions: number | null = null;
            try {
                const detailResponse = await fetch(`${item.repository_url}/pulls/${item.number}`, { headers });
                if (detailResponse.ok) {
                    const detail = await detailResponse.json();
                    additions = detail.additions ?? null;
                    deletions = detail.deletions ?? null;
                }
            } catch {}
            return {
                repo: item.repository_url.replace('https://api.github.com/repos/', ''),
                title: item.title,
                url: item.html_url,
                additions,
                deletions,
            };
        }));
    }
} catch (error) {
    console.error('[PullRequests] request threw:', error);
    loadError = true;
    pullRequests = [];
}
---

{(loadError || pullRequests.length > 0) && (
    <section class="mx-auto flex w-[calc(100%-5rem)] max-w-120 flex-col justify-center gap-4 py-12 font-family-cause sm:w-full" aria-label="Merged pull requests">
        <div class="flex items-center justify-between text-xs text-neutral-500">
            <span class="text-[13px]">Pull requests</span>
            {!loadError && <span>{pullRequests.length} merged</span>}
        </div>

        {loadError && <p class="text-xs text-neutral-500">Couldn't load pull requests right now.</p>}

        <ul class="flex flex-col gap-3">
            {pullRequests.slice(0, RECENT_COUNT).map((pr) => (
                <li>
                    <a href={pr.url} target="_blank" rel="noopener noreferrer" class="group flex flex-col gap-0.5 transition-colors hover:text-neutral-950">
                        <span class="text-[13px] text-neutral-900 group-hover:underline">{pr.title}</span>
                        <span class="text-xs text-neutral-500">
                            {pr.repo}
                            {pr.additions !== null && pr.deletions !== null && (
                                <span>
                                    {' · '}
                                    <span class="text-[#1C7448]">+{pr.additions}</span>{' '}
                                    <span class="text-[#741C1C]">−{pr.deletions}</span>
                                </span>
                            )}
                        </span>
                    </a>
                </li>
            ))}
        </ul>

        {pullRequests.length > RECENT_COUNT && (
            <details class="group">
                <summary class="cursor-pointer list-none text-xs text-neutral-500 transition-colors hover:text-neutral-950 [&::-webkit-details-marker]:hidden">
                    <span class="group-open:hidden">Show more ({pullRequests.length - RECENT_COUNT})</span>
                    <span class="hidden group-open:inline">Show less</span>
                </summary>
                <ul class="mt-3 flex flex-col gap-3">
                    {pullRequests.slice(RECENT_COUNT).map((pr) => (
                        <li>
                            <a href={pr.url} target="_blank" rel="noopener noreferrer" class="group flex flex-col gap-0.5 transition-colors hover:text-neutral-950">
                                <span class="text-[13px] text-neutral-900 group-hover:underline">{pr.title}</span>
                                <span class="text-xs text-neutral-500">
                                    {pr.repo}
                                    {pr.additions !== null && pr.deletions !== null && (
                                        <span>
                                            {' · '}
                                            <span class="text-[#1C7448]">+{pr.additions}</span>{' '}
                                            <span class="text-[#741C1C]">−{pr.deletions}</span>
                                        </span>
                                    )}
                                </span>
                            </a>
                        </li>
                    ))}
                </ul>
            </details>
        )}
    </section>
)}
