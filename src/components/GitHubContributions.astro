---
import { getGithubData } from '../lib/github';
const { days, total } = await getGithubData();

const LEVEL_CLASSES = [
  'bg-neutral-200/70',
  'bg-[#741C1C]/25',
  'bg-[#741C1C]/50',
  'bg-[#741C1C]/75',
  'bg-[#741C1C]',
];

// Pad so the first column lines up with Sunday
const pad = days.length ? new Date(`${days[0].date}T00:00:00Z`).getUTCDay() : 0;
---

<section class="mx-auto flex w-[calc(100%-5rem)] max-w-120 flex-col justify-center gap-4 py-12 font-family-cause sm:w-full" aria-label="GitHub contributions">
  <div class="flex items-center justify-between text-xs text-neutral-500">
    <span class="text-[13px]">GitHub</span>
    <a href="https://github.com/justKevv" target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-neutral-950">@justKevv</a>
  </div>

  {days.length > 0 ? (
    <>
      <div class="grid grid-flow-col grid-rows-7 auto-cols-fr gap-[3px]" role="img" aria-label={`${total} GitHub contributions in the last year`}>
        {Array.from({ length: pad }).map(() => <span class="aspect-square" />)}
        {days.map((d) => (
          <span
            class={`aspect-square rounded-[2px] ${LEVEL_CLASSES[d.level]}`}
            title={`${d.count} contribution${d.count === 1 ? '' : 's'} on ${d.date}`}
          />
        ))}
      </div>
      <p class="text-center text-xs text-neutral-500">{total} contributions in the last year</p>
    </>
  ) : (
    <p class="text-center text-xs text-neutral-500">Couldn't load contributions right now.</p>
  )}
</section>