---
import "../styles/global.css";
import SEO from "../components/SEO.astro";
import type { ImageMetadata } from "astro";
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import DotGrid from "../components/react/DotGrid";
import { ClientRouter } from "astro:transitions";

interface Props {
    title?: string;
    description?: string;
    image?: string | ImageMetadata;
    type?: "website" | "article";
    noindex?: boolean;
    isPinnedFooter?: boolean;
    jsonLd?: Record<string, unknown>;
    publishedTime?: string;
    modifiedTime?: string;
    author?: string;
    section?: string;
    tags?: string[];
}

const { title, description, image, type, noindex, isPinnedFooter = false, jsonLd, publishedTime, modifiedTime, author, section, tags } = Astro.props;

---

<!doctype html>
<html lang="en" transition:animate="none">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/png" sizes="128x128" href="/文.png" />
        <meta name="generator" content={Astro.generator} />
        <script defer is:inline src="https://cloud.umami.is/script.js" data-website-id="67a8fb86-ca7a-40ad-9d0a-828e794826cc"></script>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
          rel="preload"
          as="style"
          href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&display=swap"
          onload="this.onload=null;this.rel='stylesheet'"
        />
        <noscript>
          <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&display=swap" rel="stylesheet" />
        </noscript>
        <SEO
            title={title}
            description={description}
            image={image}
            type={type}
            noindex={noindex}
            jsonLd={jsonLd}
            publishedTime={publishedTime}
            modifiedTime={modifiedTime}
            author={author}
            section={section}
            tags={tags}
        />
        <ClientRouter />
    </head>
    <body class="overflow-hidden">
        <main class:list={["relative w-full h-dvh flex flex-col overflow-hidden", isPinnedFooter && "max-w-360 mx-auto"]}>
            <div class="page-content relative z-10 flex min-h-0 flex-1 flex-col">
                {isPinnedFooter ? <Navbar /> : <div class="w-full max-w-360 mx-auto"><Navbar /></div>}
                {isPinnedFooter ? (
                    <>
                        <div class="flex-1 min-h-0 overflow-y-auto scroll-smooth">
                            <slot />
                        </div>
                        <Footer />
                    </>
                ) : (
                    <div class="flex-1 min-h-0 overflow-y-auto scroll-smooth">
                        <div class="min-h-full w-full max-w-360 mx-auto flex flex-col">
                            <div class="flex-1 flex flex-col">
                                <slot />
                            </div>
                            <Footer />
                        </div>
                    </div>
                )}
            </div>
            <div class="pointer-events-none absolute inset-0 z-0 flex items-center justify-center" aria-hidden="true">
            <DotGrid
                client:load
                dotSize={3}
                gap={18}
                baseColor="#f3f3f3"
                activeColor="#d1d1d1"
                proximity={100}
                shockRadius={100}
                shockStrength={5}
                resistance={750}
                returnDuration={0.8}
                />
            </div>
        </main>
    </body>

    <script>
      import { bind, setVolume } from "cuelume";
    
      bind();

      setVolume(1)
    </script>
</html>